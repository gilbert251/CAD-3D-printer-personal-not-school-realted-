from math import sqrt

def write_cube(path, width, depth, height):
    if min(width, depth, height) <= 0:
        raise ValueError("Dimensions must be greater than zero.")
        
    vertices = [
        (0, 0, 0), (width, 0, 0), (width, depth, 0), (0, depth, 0),
        (0, 0, height), (width, 0, height), (width, depth, height), (0, depth, height),
    ]
    
    faces = (
        (0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4),
        (3, 7, 6, 2), (0, 4, 7, 3), (1, 2, 6, 5),
    )

    def subtract(a, b):
        return (a[0] - b[0], a[1] - b[1], a[2] - b[2])

    def normal(a, b, c):
        u = subtract(b, a)
        v = subtract(c, a)
        nx = u[1] * v[2] - u[2] * v[1]
        ny = u[2] * v[0] - u[0] * v[2]
        nz = u[0] * v[1] - u[1] * v[0]
        length = sqrt(nx*nx + ny*ny + nz*nz)
        return (nx / length, ny / length, nz / length)

    with open(path, "w", encoding="ascii") as stl:
        stl.write("solid calibration_cube\n")
        for face in faces:
            triangles = [
                (face[0], face[1], face[2]),
                (face[0], face[2], face[3])
            ]
            for i1, i2, i3 in triangles:
                a, b, c = vertices[i1], vertices[i2], vertices[i3]
                nx, ny, nz = normal(a, b, c)
                stl.write(f"  facet normal {nx:.6g} {ny:.6g} {nz:.6g}\n")
                stl.write("    outer loop\n")
                for x, y, z in (a, b, c):
                    stl.write(f"      vertex {x:.6g} {y:.6g} {z:.6g}\n")
                stl.write("    endloop\n  endfacet\n")
        stl.write("endsolid calibration_cube\n")

if __name__ == "__main__":
    write_cube("CAD.stl", 20.0, 20.0, 20.0)
    print("Success! CAD.stl now has 3D data.")
