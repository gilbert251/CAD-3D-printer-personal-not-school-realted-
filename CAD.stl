import argparse
from math import sqrt
import subprocess
import os
import platform

def write_cube(path, width, depth, height):
    if min(width, depth, height) <= 0:
        raise ValueError("Cube dimensions must all be greater than zero.")
        
    vertices = [
        (0, 0, 0), (width, 0, 0), (width, depth, 0), (0, depth, 0),
        (0, 0, height), (width, 0, height), (width, depth, height), (0, depth, height),
    ]
    
    faces = (
        (0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4),
        (3, 7, 6, 2), (0, 4, 7, 3), (1, 2, 6, 5),
    )

    def subtract(a, b):
        return tuple(a[i] - b[i] for i in range(3))

    def normal(a, b, c):
        u, v = subtract(b, a), subtract(c, a)
        n = (u[1] * v[2] - u[2] * v[1], u[2] * v[0] - u[0] * v[2], u[0] * v[1] - u[1] * v[0])
        length = sqrt(sum(value * value for value in n))
        return tuple(value / length for value in n)

    with open(path, "w", encoding="ascii") as stl:
        stl.write("solid calibration_cube\n")
        for face in faces:
            for indices in ((face[0], face[1], face[2]), (face[0], face[2], face[3])):
                a, b, c = (vertices[i] for i in indices)
                nx, ny, nz = normal(a, b, c)
                stl.write(f"facet normal {nx:.6g} {ny:.6g} {nz:.6g}\n")
                stl.write("  outer loop\n")
                for x, y, z in (a, b, c):
                    stl.write(f"    vertex {x:.6g} {y:.6g} {z:.6g}\n")
                stl.write("  endloop\nendsfacet\n")
        stl.write("endsolid calibration_cube\n")

    # --- AUTOMATIC TRANSLATION TO BAMBU STUDIO ---
    print(f"STL successfully created at: {os.path.abspath(path)}")
    print("Launching Bambu Studio...")
    
    try:
        if platform.system() == "Windows":
            # Standard path for Windows installation
            bambu_path = r"C:\Program Files\Bambu Studio\bambu-studio.exe"
            if os.path.exists(bambu_path):
                subprocess.Popen([bambu_path, os.path.abspath(path)])
            else:
                # Fallback to system search if installed elsewhere
                os.startfile(os.path.abspath(path))
                
        elif platform.system() == "Darwin":  # macOS
            subprocess.Popen(["open", "-a", "Bambu Studio", os.path.abspath(path)])
            
    except Exception as e:
        print(f"Could not open Bambu Studio automatically: {e}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Generate a 3D-printable calibration block.")
    parser.add_argument("--width", type=float, default=20.0)
    parser.add_argument("--depth", type=float, default=20.0)
    parser.add_argument("--height", type=float, default=20.0)
    parser.add_argument("--output", default="calibration_cube.stl")
    
    args = parser.parse_args()
    write_cube(args.output, args.width, args.depth, args.height)
